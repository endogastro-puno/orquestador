*.docm  binary
*.dotx  binary
*.dotm  binary
*.xlsx  binary
*.xlsm  binary
*.xltx  binary
*.xlsb  binary
*.pptx  binary
*.pptm  binary
*.potx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   binary
*.ico   binary
*.webp  binary
*.zip   binary
*.ttf   binary
